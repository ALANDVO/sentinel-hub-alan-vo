# sentinel-hub-alan-vo
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Keycloak OIDC
OIDC_ISSUER_URL=http://localhost:8080/realms/sentinel-hub
OIDC_CLIENT_ID=sentinel-hub
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile email roles

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=RS256
JWT_AUDIENCE=sentinel-hub-api

# LLM (optional)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# Environment
DEBUG=false
ENVIRONMENT=development